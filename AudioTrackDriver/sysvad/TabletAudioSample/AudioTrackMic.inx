;
; AudioTrackMic.inf
;
; Audiotrack virtual cable: audio played to "Audiotrack Out" (render) comes out
; of "Audiotrack Mic" (capture). Derived from the Microsoft SysVAD sample (MS-PL).
; Keep this file ASCII: INF files are not UTF-8.
;

[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = 10/15/2026, 1.0.0.0
CatalogFile = audiotrackmic.cat
PnpLockdown = 1

[SourceDisksNames]
222 = "Audiotrack Driver Disk","",222

[SourceDisksFiles]
audiotrackmic.sys = 222

[Manufacturer]
%MfgName% = AudioTrack,NT$ARCH$.10.0...19041

[AudioTrack.NT$ARCH$.10.0...19041]
%AudioTrack.DeviceDesc% = AudioTrack_Dev, Root\AudioTrackMic

[DestinationDirs]
AudioTrack_Dev.CopyList = 13   ; 13 = Package's DriverStore directory

;======================================================
; Device
;======================================================
[AudioTrack_Dev.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration, WDMAUDIO.Registration
CopyFiles=AudioTrack_Dev.CopyList
AddReg=AudioTrack_Dev.AddReg

[AudioTrack_Dev.CopyList]
audiotrackmic.sys

[AudioTrack_Dev.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,audiotrackmic.sys

HKR,Drivers,SubClasses,,"wave,midi,mixer"

HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv

HKR,Drivers\wave\wdmaud.drv,Description,,%AudioTrack.DeviceDesc%
HKR,Drivers\midi\wdmaud.drv,Description,,%AudioTrack.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%AudioTrack.DeviceDesc%

[AudioTrack_Dev.NT.Interfaces]
;
; Audiotrack Out: render endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_WaveSpeaker%,     AT.I.WaveSpeaker
AddInterface=%KSCATEGORY_RENDER%,   %KSNAME_WaveSpeaker%,     AT.I.WaveSpeaker
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveSpeaker%,     AT.I.WaveSpeaker
AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_TopologySpeaker%, AT.I.TopologySpeaker
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologySpeaker%, AT.I.TopologySpeaker

;
; Audiotrack Mic: capture endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_WaveMicIn%,       AT.I.WaveMicIn
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveMicIn%,       AT.I.WaveMicIn
AddInterface=%KSCATEGORY_CAPTURE%,  %KSNAME_WaveMicIn%,       AT.I.WaveMicIn
AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_TopologyMicIn%,   AT.I.TopologyMicIn
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyMicIn%,   AT.I.TopologyMicIn

;======================================================
; render interface: Audiotrack Out
;======================================================
[AT.I.WaveSpeaker]
AddReg=AT.I.WaveSpeaker.AddReg
[AT.I.WaveSpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%AT.WaveSpeaker.szPname%

[AT.I.TopologySpeaker]
AddReg=AT.I.TopologySpeaker.AddReg
[AT.I.TopologySpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%AT.TopologySpeaker.szPname%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
; Opt in to pull (event driven) mode.
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

;======================================================
; capture interface: Audiotrack Mic
;======================================================
[AT.I.WaveMicIn]
AddReg=AT.I.WaveMicIn.AddReg
[AT.I.WaveMicIn.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%AT.WaveMicIn.szPname%

[AT.I.TopologyMicIn]
AddReg=AT.I.TopologyMicIn.AddReg
[AT.I.TopologyMicIn.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%AT.TopologyMicIn.szPname%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
; Opt in to pull (event driven) mode.
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

;======================================================
; Service
;======================================================
[AudioTrack_Dev.NT.Services]
AddService=audiotrackmic,0x00000002,AudioTrack_Service_Inst

[AudioTrack_Service_Inst]
DisplayName=%AudioTrack.SvcDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\audiotrackmic.sys

[AudioTrack_Dev.NT.HW]
AddReg = AUDIOHW.AddReg

[AUDIOHW.AddReg]
; FILE_DEVICE_SOUND
HKR,,DeviceType,0x10001,0x0000001D
; SDDL_DEVOBJ_SYS_ALL_ADM_RWX_WORLD_RWX_RES_RWX
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

;======================================================
; WDF
;======================================================
[AudioTrack_Dev.NT.Wdf]
KmdfService = audiotrackmic, AudioTrack_WdfSect

[AudioTrack_WdfSect]
KmdfLibraryVersion = $KMDFVERSION$

;======================================================
; Strings
;======================================================
[Strings]

; Non-localizable. The KSNAME values must match the miniport names in minipairs.h.
KSNAME_WaveSpeaker="WaveSpeaker"
KSNAME_TopologySpeaker="TopologySpeaker"
KSNAME_WaveMicIn="WaveMicIn"
KSNAME_TopologyMicIn="TopologyMicIn"

Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY="{DDA54A40-1E4C-11D1-A050-405705C10000}"

KSNODETYPE_ANY="{00000000-0000-0000-0000-000000000000}"

PKEY_AudioEndpoint_Association               = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"

; Localizable
ProviderName = "Audiotrack"
MfgName      = "Audiotrack"

AudioTrack.DeviceDesc = "Audiotrack Virtual Audio"
AudioTrack.SvcDesc    = "Audiotrack Virtual Audio Driver"

AT.WaveSpeaker.szPname     = "Audiotrack Out"
AT.TopologySpeaker.szPname = "Audiotrack Out"
AT.WaveMicIn.szPname       = "Audiotrack Mic"
AT.TopologyMicIn.szPname   = "Audiotrack Mic"
